      { "type": "slider", "messageKey": "WindowEndHour", "defaultValue": 17, "label": "End Hour (0-23)", "min": 0, "max": 23 },
      { "type": "slider", "messageKey": "JokesPerWindow", "defaultValue": 3, "label": "Jokes per Window", "min": 1, "max": 20 }
