          { "label": "Small", "value": "0" },
          { "label": "Medium", "value": "1" },
          { "label": "Large", "value": "2" },
          { "label": "Extra Large", "value": "3" }
        ]
      },
      { "type": "slider", "messageKey": "TimeoutSec", "defaultValue": 30, "label": "App Timeout (0 = Never)", "min": 0, "max": 120, "step": 15 }
