          { "label": "Random within Window", "value": "1" }
        ]
      },
      { "type": "slider", "messageKey": "SpecificHour", "defaultValue": 12, "label": "Specific Hour (0-23)", "min": 0, "max": 23 },
      { "type": "slider", "messageKey": "SpecificMinute", "defaultValue": 0, "label": "Specific Minute (0-59)", "min": 0, "max": 59 }
    ]
  },
  {
    "type": "section",
    "items": [
